# Copy to .env, fill in what you need, and run commands with `uv run --env-file .env ...` (or export these in your shell).

# fal.ai: concept art, keyframes, and video clips (every generating script in scripts/)
FAL_KEY=

# Only for scripts/vocal_map.py: a private scratch directory outside the repo. Its raw transcript of the original song
# is written there, so no original lyrics land in the project.
SCRATCH=

# Only for `scripts/media_backup.py upload`: an S3-compatible bucket (Cloudflare R2) and its public base URL.
# Restoring the media with `media_backup.py download` needs none of these.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_API_ENDPOINT=
S3_BUCKET_NAME=
S3_PUBLIC_URL=

# Only for scripts/publish_notion.py: a Notion integration with access to the Projects database (the write-up draft)
NOTION_API_TOKEN=
NOTION_API_VERSION=2026-03-11
