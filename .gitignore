/node_modules
/.pnp
.pnp.js

# testing
/coverage
/playwright-report
/test-results

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# misc
.DS_Store
*.pem

# ide
.idea

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# pnpm
.pnpm-store

# local env files
.env
.env.local
local.env
.env.build
.env.development.local
